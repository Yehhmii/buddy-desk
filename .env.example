# OPTIONAL. You can paste all of these inside the app under Settings > AI providers,
# which is what most people should do. This file is for developers who prefer it.
# Copy to .env (project root while developing). One key is enough.

# Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid API (not a ChatGPT subscription): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Paid API (not a Claude subscription): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the wake-word model download URL (https only).
# BUDDY_VOSK_MODEL_URL=
