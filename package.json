{
  "name": "buddy-desk",
  "productName": "Jarvis Desk",
  "version": "0.1.0",
  "description": "A voice-first desktop assistant: tasks, alarms, screenshots and a daily report, run by talking.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Jarvis Desk contributors",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "marked": "^18.1.3",
    "msedge-tts": "^2.1.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vosk-browser": "^0.0.8",
    "zustand": "^5.0.16"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "homepage": "https://github.com/yehhmii/buddy-desk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehhmii/buddy-desk.git"
  },
  "bugs": {
    "url": "https://github.com/yehhmii/buddy-desk/issues"
  },
  "keywords": [
    "assistant",
    "voice",
    "electron",
    "tasks",
    "alarms",
    "wake-word",
    "groq",
    "gemini",
    "openai",
    "claude"
  ]
}
